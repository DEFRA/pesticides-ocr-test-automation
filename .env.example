# Target URL used when ENVIRONMENT is not set (local, GitHub and Docker runs)
BASE_URL=http://localhost:3000

# BrowserStack (only needed for npm run test:browserstack)
BROWSERSTACK_USER=
BROWSERSTACK_KEY=
BROWSERSTACK_BUILD_NAME="pesticides-ocr-test-automation local"

# Injected by the CDP platform - do not set locally
# ENVIRONMENT=dev
# HTTP_PROXY=http://localhost:3128
